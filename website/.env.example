# OpenRouter API Key for local development (OPTIONAL)
# Get your key at https://openrouter.ai/keys
# Copy this file to .env and add your actual key if you want to use the vibe tab
# Note: PUBLIC_ prefix is required for Astro to expose this to the client
# For production: Set PUBLIC_OPENROUTER_API_KEY in Netlify environment variables
# PUBLIC_OPENROUTER_API_KEY=your-openrouter-key-here
